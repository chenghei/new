# 数据库配置
DB_HOST=localhost
DB_USER=connect
DB_PASSWORD=123456
DB_NAME=template
DB_PORT=3306

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# 服务器配置
PORT=5000
NODE_ENV=development

# CORS配置
FRONTEND_URL=http://localhost:3000

# Redis配置（用于AI结果缓存、AI并发控制、JWT登出黑名单）
# REDIS_ENABLED 不为 true 时自动降级为无 Redis 模式，不影响任何主流程
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI缓存与并发控制
AI_CACHE_TTL=600
AI_MAX_CONCURRENCY=5